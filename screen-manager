#!/usr/bin/env bash
#
# screen-manager
#
# Interactive screen selection. The tab line shows every connected screen in
# its physical order: the screens that are on from left to right (mirrored
# screens together), followed by the screens that are off. Left/Right moves
# between screens, Up/Down moves between the options of the selected screen,
# Enter applies the highlighted option, q quits.
#
# Connections: the set of external screens that are connected (identified by
# EDID vendor, product and serial number, so it does not matter which port or
# dock they sit on) is a connection. The first tab, "Connection (...)", belongs
# to it. A connection can be named, and the layout last applied here is saved
# for it in ~/.config/screen-manager/connections. When a known connection shows
# up (at start or when it is plugged in) the cursor lands on "restore saved
# layout", so one Enter brings back the latest layout.
#
# i3 workspaces: when ~/.config/screen-manager/workspaces exists, the workspace
# assignments of the screens that are on are written to ~/.config/i3/screens.conf
# (include it from the i3 config) and i3 is reloaded when they change. The file
# has one line per screen model: "vendor:product workspace ...", ranges like 1-10
# allowed. A screen that is connected but off keeps its workspaces assigned (i3
# applies them when it is turned on); the workspaces of a screen model that is not
# connected at all go to the leftmost screen that is on.
#
# Screens are named after their EDID: "Dell (U3423WE)". Identical names get the
# suffix a, b, c, ... Screens without EDID are named after their output.
#
# The state is read from xrandr when the script starts and then kept live: when
# screens are plugged in, unplugged or changed (by this script or anything
# else) the screens and their options update by themselves, so only options
# that are possible right now can be selected.
#
# The screens that are on always form one row, packed from the left edge, in
# the order shown. Options:
#   off                    offered while another screen stays on; for the only
#                          screen that is on it is offered when another connected
#                          screen can be turned on instead, and that one is
#                          turned on in the same step so no screen is left dark
#   on                     only offered for an off screen when no screen is on
#   mirror <screen>        join that screen; only offered when they share a resolution
#   add left of <screen>   put the screen in the row directly left of that screen
#   add right of <screen>  put the screen in the row directly right of that screen
#                          (the option also names the screen it ends up left of)

set -u

if ! command -v xrandr >/dev/null 2>&1; then
  echo "xrandr is not installed" >&2
  exit 1
fi

if [[ ! -t 0 || ! -t 1 ]]; then
  echo "screen-manager needs an interactive terminal" >&2
  exit 1
fi

readonly refresh_interval=1        # seconds between cheap state checks
readonly probe_interval=5          # seconds between full probes of the connectors
readonly maximum_model_length=12
readonly connection_entry="@connection"  # the tab of the connection, not an output
readonly connections_file="${XDG_CONFIG_HOME:-$HOME/.config}/screen-manager/connections"
readonly workspaces_file="${XDG_CONFIG_HOME:-$HOME/.config}/screen-manager/workspaces"
readonly i3_screens_file="${XDG_CONFIG_HOME:-$HOME/.config}/i3/screens.conf"

declare -a base_names=() screen_names=() tab_names=() active_names=() group_members=()
declare -A screen_active=() position_x=() position_y=() width=() height=() preferred_mode=() mode_list=()
declare -A edid_vendor=() edid_model=() edid_product=() edid_serial=() identity_of=()
declare -A screen_label=() group_index=() vendor_cache=() connection_name=() connection_layout=()
declare -a option_screen=() option_action=() option_reference=() option_text=()
declare -A first_option=() screen_option_count=()
group_count=0
option_count=0
connection_fingerprint=""
apply_changed_layout=0
status_row=1
vendor_result=""
snapshot=""
status_message=""
cursor_screen_index=0
cursor_option_offset=0

# One line per connected output:
# name|geometry|preferred mode|comma separated modes|EDID vendor|EDID model|EDID product|EDID serial
# Without --current xrandr probes the connectors again, which finds newly plugged screens.
query_screens() {
  xrandr --prop "$@" 2>/dev/null | awk '
    function hexvalue(character) { return index("0123456789abcdef", tolower(character)) - 1 }
    function byte(position) {
      return hexvalue(substr(edid, 2 * position + 1, 1)) * 16 + hexvalue(substr(edid, 2 * position + 2, 1))
    }
    function decode_edid(   value, block, offset, position, character, text, number) {
      manufacturer = ""; model = ""; product = ""; serial = ""
      if (length(edid) < 256) return
      value = byte(8) * 256 + byte(9)
      manufacturer = sprintf("%c%c%c", 64 + int(value / 1024) % 32, 64 + int(value / 32) % 32, 64 + value % 32)
      product = sprintf("0x%04x", byte(11) * 256 + byte(10))
      number = byte(15) * 16777216 + byte(14) * 65536 + byte(13) * 256 + byte(12)
      if (number != 0) serial = sprintf("%d", number)
      for (block = 0; block < 4; block++) {
        offset = 54 + 18 * block
        if (byte(offset) == 0 && byte(offset + 1) == 0 && byte(offset + 2) == 0 && (byte(offset + 3) == 252 || byte(offset + 3) == 255)) {
          text = ""
          for (position = 5; position < 18; position++) {
            character = byte(offset + position)
            if (character == 10) break
            text = text sprintf("%c", (character >= 32 && character < 127 && character != 124) ? character : 32)
          }
          gsub(/^ +| +$/, "", text)
          if (byte(offset + 3) == 252) model = text; else if (text != "") serial = text
        }
      }
    }
    function flush() {
      if (name != "") {
        if (preferred == "") preferred = first
        decode_edid()
        print name "|" geometry "|" preferred "|" modes "|" manufacturer "|" model "|" product "|" serial
      }
      name = ""
    }
    /^[^ \t]/ {
      flush()
      if ($2 == "connected") {
        name = $1; geometry = ""; preferred = ""; first = ""; modes = ""; edid = ""; in_edid = 0
        if (match($0, /[0-9]+x[0-9]+\+[0-9]+\+[0-9]+/)) geometry = substr($0, RSTART, RLENGTH)
      }
      next
    }
    name != "" && /^\tEDID:/ { in_edid = 1; edid = ""; next }
    name != "" && in_edid && /^\t\t[0-9a-fA-F]+[ \t]*$/ { edid = edid $1; next }
    name != "" && /^ +[0-9]+x[0-9]+/ {
      in_edid = 0
      modes = modes (modes == "" ? "" : ",") $1
      if (first == "") first = $1
      if (preferred == "" && index($0, "+") > 0) preferred = $1
      next
    }
    name != "" { in_edid = 0 }
    END { flush() }
  '
}

is_builtin() {
  [[ $1 =~ ^(eDP|LVDS|DSI) ]]
}

is_active() {
  [[ -n ${screen_active[$1]:-} ]]
}

display_name() {
  echo "${screen_label[$1]:-$1}"
}

# Prints the members (a space separated list) without the given screen.
without_member() {
  local result="" member
  for member in $1; do
    [[ $member == "$2" ]] || result+="${result:+ }$member"
  done
  echo "$result"
}

# Prints the display names of a space separated list of screens, joined with " & ".
members_label() {
  local member result=""
  for member in $1; do
    result+="${result:+ & }$(display_name "$member")"
  done
  echo "$result"
}

# Sets vendor_result to the short vendor name for an EDID vendor id ("DEL" -> "Dell").
resolve_vendor() {
  local identifier=$1 full=""
  if [[ -z ${vendor_cache[$identifier]:-} ]]; then
    if command -v systemd-hwdb >/dev/null 2>&1; then
      full=$(systemd-hwdb query "acpi:$identifier:" 2>/dev/null | sed -n 's/^ID_VENDOR_FROM_DATABASE=//p' | head -n 1)
    fi
    if [[ -z $full && -r /usr/share/hwdata/pnp.ids ]]; then
      full=$(awk -F'\t' -v identifier="$identifier" '$1 == identifier { print $2; exit }' /usr/share/hwdata/pnp.ids)
    fi
    full=${full%% *}
    full=${full%,}
    full=${full%.}
    vendor_cache[$identifier]=${full:-$identifier}
  fi
  vendor_result=${vendor_cache[$identifier]}
}

# Names every screen from its EDID; identical names get the suffix a, b, c, ...
assign_labels() {
  local alphabet=abcdefghijklmnopqrstuvwxyz name model label seen
  local -a words=()
  local -A base_label=() label_total=() label_seen=()
  screen_label=()

  for name in "${base_names[@]}"; do
    if [[ -z ${edid_vendor[$name]} ]]; then
      label=$name
      is_builtin "$name" && label="Built-in ($name)"
    else
      resolve_vendor "${edid_vendor[$name]}"
      model=${edid_model[$name]}
      read -ra words <<<"$model"
      model="${words[*]:-}"
      if [[ ${model,,} == "${vendor_result,,} "* ]]; then
        model=${model:${#vendor_result}+1}
      fi
      model=${model:0:maximum_model_length}
      [[ -n $model ]] || model=${edid_product[$name]}
      if is_builtin "$name"; then
        label="Built-in ($vendor_result $model)"
      else
        label="$vendor_result ($model)"
      fi
    fi
    base_label[$name]=$label
    label_total[$label]=$(( ${label_total[$label]:-0} + 1 ))
  done

  for name in "${base_names[@]}"; do
    label=${base_label[$name]}
    if (( ${label_total[$label]} > 1 )); then
      seen=$(( ${label_seen[$label]:-0} + 1 ))
      label_seen[$label]=$seen
      label+=" ${alphabet:seen-1:1}"
    fi
    screen_label[$name]=$label
  done
}

# Fills the screen arrays from $snapshot.
load_screens() {
  base_names=()
  screen_names=()
  active_names=()
  group_members=()
  group_count=0
  screen_active=()
  position_x=()
  position_y=()
  width=()
  height=()
  preferred_mode=()
  mode_list=()
  edid_vendor=()
  edid_model=()
  edid_product=()
  edid_serial=()
  identity_of=()
  group_index=()

  local -a builtin_names=() external_names=() external_identities=()
  local name geometry preferred modes vendor model product serial
  while IFS='|' read -r name geometry preferred modes vendor model product serial; do
    [[ -n $name ]] || continue
    if [[ $geometry =~ ^([0-9]+)x([0-9]+)\+([0-9]+)\+([0-9]+)$ ]]; then
      screen_active[$name]=1
      width[$name]=${BASH_REMATCH[1]}
      height[$name]=${BASH_REMATCH[2]}
      position_x[$name]=${BASH_REMATCH[3]}
      position_y[$name]=${BASH_REMATCH[4]}
      active_names+=("$name")
    fi
    preferred_mode[$name]=$preferred
    mode_list[$name]=$modes
    edid_vendor[$name]=$vendor
    edid_model[$name]=$model
    edid_product[$name]=$product
    edid_serial[$name]=$serial
    if is_builtin "$name"; then
      builtin_names+=("$name")
    else
      external_names+=("$name")
    fi
  done <<<"$snapshot"

  base_names=("${builtin_names[@]}" "${external_names[@]}")
  assign_labels

  # The identity of a screen does not depend on the port or dock it sits on.
  for name in "${base_names[@]}"; do
    if is_builtin "$name"; then
      identity_of[$name]=builtin
    elif [[ -n ${edid_vendor[$name]} ]]; then
      identity_of[$name]="${edid_vendor[$name]}:${edid_product[$name]}:${edid_serial[$name]:--}"
      external_identities+=("${identity_of[$name]}")
    else
      identity_of[$name]="output:$name"
      external_identities+=("${identity_of[$name]}")
    fi
  done
  connection_fingerprint=""
  if (( ${#external_identities[@]} > 0 )); then
    connection_fingerprint=$(printf '%s\n' "${external_identities[@]}" | sort | paste -sd+)
  fi

  # Groups: screens at the same position mirror each other. Groups are ordered left to right.
  local x y previous_position=""
  while read -r x y name; do
    [[ -n $name ]] || continue
    if [[ $x,$y == "$previous_position" ]]; then
      group_members[$(( group_count - 1 ))]+=" $name"
    else
      group_members[$group_count]=$name
      group_count=$(( group_count + 1 ))
      previous_position=$x,$y
    fi
    group_index[$name]=$(( group_count - 1 ))
  done < <(for name in "${active_names[@]}"; do printf '%s %s %s\n' "${position_x[$name]}" "${position_y[$name]}" "$name"; done | sort -s -n -k1,1 -k2,2)

  # Display order: the screens that are on from left to right, then the screens that are off.
  local group
  for (( group = 0; group < group_count; group++ )); do
    screen_names+=(${group_members[$group]})
  done
  for name in "${base_names[@]}"; do
    is_active "$name" || screen_names+=("$name")
  done

  # Tabs: the connection first (when something external is connected), then the screens.
  tab_names=()
  if [[ -n $connection_fingerprint ]]; then
    local title=unnamed
    connection_is_known || title=new
    [[ -z ${connection_name[$connection_fingerprint]:-} ]] || title=${connection_name[$connection_fingerprint]}
    screen_label[$connection_entry]="Connection ($title)"
    tab_names+=("$connection_entry")
  fi
  tab_names+=("${screen_names[@]}")
}

# --- i3 workspaces --------------------------------------------------------

# Prints the connected screen (on or off) with the given vendor:product; fails when there is none.
screen_for_model() {
  local name
  for name in "${base_names[@]}"; do
    if [[ ${edid_vendor[$name]}:${edid_product[$name]} == "$1" ]]; then
      echo "$name"
      return 0
    fi
  done
  return 1
}

# Writes the workspace assignments of the screens that are on to the i3 include file and
# reloads i3 when they changed.
update_workspace_assignments() {
  [[ -r $workspaces_file ]] || return 0
  (( group_count > 0 )) || return 0

  local line model rest token index start end number target content
  local -a models=() workspace_lists=()
  local -A workspace_output=()

  while IFS= read -r line; do
    line=${line%%\#*}
    read -r model rest <<<"$line"
    [[ -n $model && -n $rest ]] || continue
    models+=("$model")
    workspace_lists+=("$rest")
  done <"$workspaces_file"
  (( ${#models[@]} > 0 )) || return 0

  for index in "${!models[@]}"; do
    target=$(screen_for_model "${models[$index]}") || target=${group_members[0]%% *}
    for token in ${workspace_lists[$index]}; do
      if [[ $token =~ ^([0-9]+)-([0-9]+)$ ]]; then
        start=${BASH_REMATCH[1]}
        end=${BASH_REMATCH[2]}
        for (( number = start; number <= end; number++ )); do
          workspace_output[$number]=$target
        done
      elif [[ $token =~ ^[0-9]+$ ]]; then
        workspace_output[$token]=$target
      fi
    done
  done

  content="# Generated by screen-manager from $workspaces_file. Do not edit."
  for number in $(printf '%s\n' "${!workspace_output[@]}" | sort -n); do
    content+=$'\n'"workspace $number output ${workspace_output[$number]}"
  done

  if [[ -r $i3_screens_file && $(<"$i3_screens_file") == "$content" ]]; then
    return 0
  fi
  mkdir -p "${i3_screens_file%/*}" && printf '%s\n' "$content" >"$i3_screens_file" || return 0
  if command -v i3-msg >/dev/null 2>&1 && i3-msg reload >/dev/null 2>&1; then
    status_message+="${status_message:+ | }i3 workspaces updated"
  fi
}

# --- connections ----------------------------------------------------------

connection_is_known() {
  [[ -n ${connection_layout[$connection_fingerprint]:-} ]]
}

# The layout that is on now: groups left to right separated by ",", mirrored screens
# in a group joined by "&", each screen as identity@mode.
current_layout() {
  local group member group_text result=""
  for (( group = 0; group < group_count; group++ )); do
    group_text=""
    for member in ${group_members[$group]}; do
      group_text+="${group_text:+&}${identity_of[$member]}@${width[$member]}x${height[$member]}"
    done
    result+="${result:+,}$group_text"
  done
  echo "$result"
}

load_connections() {
  connection_name=()
  connection_layout=()
  [[ -r $connections_file ]] || return 0
  local fingerprint name layout
  while IFS='|' read -r fingerprint name layout; do
    [[ -n $fingerprint && -n $layout ]] || continue
    connection_name[$fingerprint]=$name
    connection_layout[$fingerprint]=$layout
  done <"$connections_file"
}

save_connections() {
  local fingerprint temporary
  mkdir -p "${connections_file%/*}" || return 1
  temporary=$(mktemp "$connections_file.XXXXXX") || return 1
  for fingerprint in "${!connection_layout[@]}"; do
    printf '%s|%s|%s\n' "$fingerprint" "${connection_name[$fingerprint]:-}" "${connection_layout[$fingerprint]}"
  done | sort >"$temporary"
  mv "$temporary" "$connections_file"
}

# Remembers the layout that is on now as the latest one of the current connection.
save_current_connection() {
  [[ -n $connection_fingerprint ]] || return 0
  connection_layout[$connection_fingerprint]=$(current_layout)
  save_connections
}

describe_connection() {
  local name screens=""
  for name in "${base_names[@]}"; do
    is_builtin "$name" || screens+="${screens:+ + }$(display_name "$name")"
  done
  if ! connection_is_known; then
    printf '%s, new connection (saved when you apply an option)' "$screens"
  elif [[ ${connection_layout[$connection_fingerprint]} == "$(current_layout)" ]]; then
    printf '%s, saved layout is in use' "$screens"
  else
    printf '%s, saved layout differs from the current layout' "$screens"
  fi
}

name_connection() {
  local entered="" word
  local -a words=()
  printf '\e[%d;1H\e[K\e[?25h' "$status_row"
  read -r -e -p "Name for this connection (empty keeps the current name): " entered
  printf '\e[?25l'
  entered=${entered//[|$'\t']/ }
  read -ra words <<<"$entered"
  entered="${words[*]:-}"
  [[ -n $entered ]] || return 0
  connection_name[$connection_fingerprint]=$entered
  connection_is_known || connection_layout[$connection_fingerprint]=$(current_layout)
  save_connections
  status_message="Named connection: $entered"
}

# Brings back the saved layout of the current connection.
restore_layout() {
  local saved=${connection_layout[$connection_fingerprint]} group_text token identity mode name members
  local -a saved_groups=() tokens=() layout_groups=() arguments=()
  local -A new_mode=() used=()

  IFS=, read -ra saved_groups <<<"$saved"
  for group_text in "${saved_groups[@]}"; do
    members=""
    IFS='&' read -ra tokens <<<"$group_text"
    for token in "${tokens[@]}"; do
      identity=${token%@*}
      mode=${token##*@}
      for name in "${base_names[@]}"; do
        [[ ${identity_of[$name]} == "$identity" && -z ${used[$name]:-} ]] || continue
        used[$name]=1
        [[ ,${mode_list[$name]}, == *",$mode,"* ]] || mode=${preferred_mode[$name]}
        new_mode[$name]=$mode
        members+="${members:+ }$name"
        break
      done
    done
    [[ -z $members ]] || layout_groups+=("$members")
  done

  if (( ${#layout_groups[@]} == 0 )); then
    status_message="Failed: none of the screens in the saved layout are connected"
    return 0
  fi
  for name in "${active_names[@]}"; do
    [[ -n ${used[$name]:-} ]] || arguments+=(--output "$name" --off)
  done
  run_layout
}

# Prints the mode the screen and all the given screens can show while mirroring (the
# current mode of the given screens when possible, otherwise the largest shared mode).
# Fails when none is shared.
mirror_mode() {
  local screen=$1 member mode best="" best_area=0 area
  shift
  local current="${width[$1]}x${height[$1]}"
  if [[ ,${mode_list[$screen]}, == *",$current,"* ]]; then
    echo "$current"
    return 0
  fi

  local -a screen_modes=()
  IFS=, read -ra screen_modes <<<"${mode_list[$screen]}"
  for mode in "${screen_modes[@]}"; do
    for member in "$@"; do
      [[ ,${mode_list[$member]}, == *",$mode,"* ]] || continue 2
    done
    [[ $mode =~ ^([0-9]+)x([0-9]+) ]] || continue
    area=$(( BASH_REMATCH[1] * BASH_REMATCH[2] ))
    if (( area > best_area )); then
      best=$mode
      best_area=$area
    fi
  done
  [[ -n $best ]] || return 1
  echo "$best"
}

# The off screen that is turned on when the only active screen is turned off.
replacement_screen() {
  local candidate
  for candidate in "${screen_names[@]}"; do
    is_active "$candidate" && continue
    [[ -n ${preferred_mode[$candidate]} ]] || continue
    echo "$candidate"
    return 0
  done
  return 1
}

add_option() {
  option_count=$(( option_count + 1 ))
  option_screen[$option_count]=$1
  option_action[$option_count]=$2
  option_reference[$option_count]=$3
  option_text[$option_count]=$4
}

# Rebuilds the option arrays: what is possible right now, per screen.
build_options() {
  option_screen=()
  option_action=()
  option_reference=()
  option_text=()
  first_option=()
  screen_option_count=()
  option_count=0

  local screen replacement count_before group members count slot reference text original_slot
  local -a candidate_groups=() candidate_origins=()

  if [[ -n $connection_fingerprint ]]; then
    first_option[$connection_entry]=$(( option_count + 1 ))
    count_before=$option_count
    if connection_is_known && [[ ${connection_layout[$connection_fingerprint]} != "$(current_layout)" ]]; then
      add_option "$connection_entry" restore "" "restore saved layout"
    fi
    if [[ -n ${connection_name[$connection_fingerprint]:-} ]]; then
      add_option "$connection_entry" name "" "rename connection"
    else
      add_option "$connection_entry" name "" "name connection"
    fi
    screen_option_count[$connection_entry]=$(( option_count - count_before ))
  fi

  for screen in "${screen_names[@]}"; do
    first_option[$screen]=$(( option_count + 1 ))
    count_before=$option_count

    # The other groups, as they would look without this screen, left to right.
    candidate_groups=()
    candidate_origins=()
    original_slot=-1
    for (( group = 0; group < group_count; group++ )); do
      members=$(without_member "${group_members[$group]}" "$screen")
      if [[ -n $members ]]; then
        candidate_groups+=("$members")
        candidate_origins+=("$group")
      else
        original_slot=${#candidate_groups[@]} # the screen is alone in its group, here
      fi
    done
    count=${#candidate_groups[@]}

    if is_active "$screen"; then
      if (( ${#active_names[@]} > 1 )); then
        add_option "$screen" off "" "off"
      elif replacement=$(replacement_screen); then
        add_option "$screen" off "$replacement" "off (turns on $(display_name "$replacement"))"
      fi
    elif [[ -z ${preferred_mode[$screen]} ]]; then
      screen_option_count[$screen]=0
      continue
    elif (( ${#active_names[@]} == 0 )); then
      add_option "$screen" on "" "on"
    fi

    for (( group = 0; group < count; group++ )); do
      if is_active "$screen" && [[ ${group_index[$screen]} == "${candidate_origins[$group]}" ]]; then
        continue # already mirroring this group
      fi
      # shellcheck disable=SC2086 # the members are a space separated list
      if mirror_mode "$screen" ${candidate_groups[$group]} >/dev/null; then
        add_option "$screen" mirror "${candidate_groups[$group]%% *}" "mirror $(members_label "${candidate_groups[$group]}")"
      fi
    done

    if (( count > 0 )); then
      for (( slot = 0; slot <= count; slot++ )); do
        (( slot == original_slot )) && continue # the screen is already there
        if (( slot == 0 )); then
          add_option "$screen" left "${candidate_groups[0]%% *}" "add left of $(members_label "${candidate_groups[0]}")"
        else
          text="add right of $(members_label "${candidate_groups[$(( slot - 1 ))]}")"
          (( slot < count )) && text+=" (left of $(members_label "${candidate_groups[$slot]}"))"
          add_option "$screen" right "${candidate_groups[$(( slot - 1 ))]%% *}" "$text"
        fi
      done
    fi

    screen_option_count[$screen]=$(( option_count - count_before ))
  done
}

describe_screen() {
  local screen=$1 mate text
  if is_active "$screen"; then
    text="output $screen, on ${width[$screen]}x${height[$screen]} at ${position_x[$screen]},${position_y[$screen]}"
    for mate in ${group_members[${group_index[$screen]}]}; do
      [[ $mate == "$screen" ]] || text+=", mirrors $(display_name "$mate")"
    done
  elif [[ -z ${preferred_mode[$screen]} ]]; then
    text="output $screen, off, no modes available"
  else
    text="output $screen, off"
  fi
  printf '%s' "$text"
}

apply_option() {
  local number=$1
  local screen=${option_screen[$number]} action=${option_action[$number]} reference=${option_reference[$number]}
  local -A new_mode=()
  local -a layout_groups=("${group_members[@]}") remaining=() arguments=()
  local members member mode index reference_index=-1 slot

  apply_changed_layout=0
  if [[ $screen == "$connection_entry" ]]; then
    case $action in
      name) name_connection ;;
      restore) restore_layout ;;
    esac
    return 0
  fi

  # Take the screen out of the row.
  for members in "${layout_groups[@]}"; do
    members=$(without_member "$members" "$screen")
    [[ -n $members ]] && remaining+=("$members")
  done
  layout_groups=("${remaining[@]}")

  if [[ -n $reference ]]; then
    for index in "${!layout_groups[@]}"; do
      [[ " ${layout_groups[$index]} " == *" $reference "* ]] && reference_index=$index
    done
  fi

  case $action in
    off)
      arguments+=(--output "$screen" --off)
      if [[ -n $reference ]]; then
        new_mode[$reference]=${preferred_mode[$reference]}
        layout_groups=("$reference")
      fi
      ;;
    on)
      new_mode[$screen]=${preferred_mode[$screen]}
      layout_groups=("$screen")
      ;;
    mirror)
      # shellcheck disable=SC2086 # the members are a space separated list
      mode=$(mirror_mode "$screen" ${layout_groups[$reference_index]})
      for member in ${layout_groups[$reference_index]}; do
        [[ $mode == "${width[$member]}x${height[$member]}" ]] || new_mode[$member]=$mode
      done
      new_mode[$screen]=$mode
      layout_groups[$reference_index]+=" $screen"
      ;;
    left|right)
      slot=$reference_index
      [[ $action == right ]] && slot=$(( slot + 1 ))
      is_active "$screen" || new_mode[$screen]=${preferred_mode[$screen]}
      layout_groups=("${layout_groups[@]:0:slot}" "$screen" "${layout_groups[@]:slot}")
      ;;
  esac

  run_layout
}

# Lays the row out from the left edge, top aligned, and applies it. Uses the caller's
# layout_groups (groups of screens left to right), new_mode (modes to set) and
# arguments (xrandr arguments so far, such as --off for screens to turn off).
run_layout() {
  local members member mode_text cursor_x=0 group_width member_width command_text error_text
  local -a parts=()

  for members in "${layout_groups[@]}"; do
    group_width=0
    for member in $members; do
      parts=()
      if [[ -n ${new_mode[$member]:-} ]]; then
        mode_text=${new_mode[$member]}
        [[ $mode_text =~ ^([0-9]+)x ]]
        member_width=${BASH_REMATCH[1]}
        if ! is_active "$member" || [[ $mode_text != "${width[$member]}x${height[$member]}" ]]; then
          parts+=(--mode "$mode_text")
        fi
      else
        member_width=${width[$member]}
      fi
      if ! is_active "$member" || [[ ${position_x[$member]} != "$cursor_x" || ${position_y[$member]} != 0 ]]; then
        parts+=(--pos "${cursor_x}x0")
      fi
      (( ${#parts[@]} > 0 )) && arguments+=(--output "$member" "${parts[@]}")
      (( member_width > group_width )) && group_width=$member_width
    done
    cursor_x=$(( cursor_x + group_width ))
  done

  if (( ${#arguments[@]} == 0 )); then
    status_message="Nothing to change"
    return 0
  fi
  printf -v command_text '%q ' xrandr "${arguments[@]}"
  if error_text=$(xrandr "${arguments[@]}" 2>&1); then
    status_message="Applied: ${command_text% }"
    apply_changed_layout=1
  else
    status_message="Failed: ${error_text:-xrandr returned an error} (${command_text% })"
  fi
}

# --- cursor ---------------------------------------------------------------

selected_option_number() {
  local screen=${tab_names[$cursor_screen_index]:-}
  [[ -n $screen ]] || return 1
  (( ${screen_option_count[$screen]:-0} > 0 )) || return 1
  echo $(( ${first_option[$screen]} + cursor_option_offset ))
}

selected_option_key() {
  local number
  number=$(selected_option_number) || return 0
  echo "${option_action[$number]}:${option_reference[$number]}"
}

# Puts the cursor back on the same screen and option after the lists were rebuilt.
restore_cursor() {
  local previous_screen=$1 previous_key=$2 previous_offset=$3 index screen count offset

  cursor_screen_index=0
  # Without a previous position start on the first screen, not on the connection.
  [[ ${tab_names[0]:-} == "$connection_entry" ]] && (( ${#tab_names[@]} > 1 )) && cursor_screen_index=1
  for index in "${!tab_names[@]}"; do
    [[ ${tab_names[$index]} == "$previous_screen" ]] && cursor_screen_index=$index
  done
  screen=${tab_names[$cursor_screen_index]:-}
  cursor_option_offset=0
  [[ -n $screen ]] || return 0

  count=${screen_option_count[$screen]}
  if [[ $screen == "$previous_screen" ]]; then
    cursor_option_offset=$previous_offset
    for (( offset = 0; offset < count; offset++ )); do
      index=$(( ${first_option[$screen]} + offset ))
      if [[ -n $previous_key && ${option_action[$index]}:${option_reference[$index]} == "$previous_key" ]]; then
        cursor_option_offset=$offset
        break
      fi
    done
  fi
  (( cursor_option_offset >= count )) && cursor_option_offset=$(( count > 0 ? count - 1 : 0 ))
  return 0
}

move_screen() {
  local target=$(( cursor_screen_index + $1 ))
  (( target >= 0 && target < ${#tab_names[@]} )) || return 0
  cursor_screen_index=$target
  cursor_option_offset=0
}

move_option() {
  local screen=${tab_names[$cursor_screen_index]:-} target
  [[ -n $screen ]] || return 0
  target=$(( cursor_option_offset + $1 ))
  (( target >= 0 && target < ${screen_option_count[$screen]} )) || return 0
  cursor_option_offset=$target
}

# --- state ----------------------------------------------------------------

# Rebuilds screens and options from $snapshot, keeping the cursor where it was.
rebuild() {
  local previous_fingerprint=$connection_fingerprint
  local previous_screen="" previous_key="" previous_offset=$cursor_option_offset
  if (( ${#tab_names[@]} > 0 )); then
    previous_screen=${tab_names[$cursor_screen_index]:-}
    previous_key=$(selected_option_key)
  fi
  load_screens
  build_options
  restore_cursor "$previous_screen" "$previous_key" "$previous_offset"
  update_workspace_assignments

  # A known connection that just showed up: default to restoring its latest layout.
  if [[ -n $connection_fingerprint && $connection_fingerprint != "$previous_fingerprint" ]] \
     && [[ ${option_action[${first_option[$connection_entry]}]:-} == restore ]]; then
    cursor_screen_index=0
    cursor_option_offset=0
  fi
}

# Reads the current state; returns 0 when it differs from what is shown.
refresh() {
  local new_snapshot
  new_snapshot=$(query_screens "$@")
  [[ $new_snapshot == "$snapshot" ]] && return 1
  snapshot=$new_snapshot
  rebuild
  return 0
}

# --- screen ---------------------------------------------------------------

render() {
  local output=$'\e[H' index screen label offset newlines
  local clear_line=$'\e[K'

  output+=$'\e[36m'"screen-manager   Left/Right: screen   Up/Down: option   Enter: apply   q: quit"$'\e[0m'"${clear_line}"$'\n'
  output+="${clear_line}"$'\n'

  if (( ${#tab_names[@]} == 0 )); then
    output+="No connected screens found${clear_line}"$'\n'
  else
    for index in "${!tab_names[@]}"; do
      screen=${tab_names[$index]}
      if [[ $screen == "$connection_entry" ]]; then
        label=$(display_name "$screen")
      else
        label="$(display_name "$screen") [$(is_active "$screen" && echo on || echo off)]"
      fi
      if (( index == cursor_screen_index )); then
        output+=$'\e[7m '"$label"$' \e[0m  '
      else
        output+=" $label  "
      fi
    done
    output+="${clear_line}"$'\n'"${clear_line}"$'\n'

    screen=${tab_names[$cursor_screen_index]}
    if [[ $screen == "$connection_entry" ]]; then
      label=$(describe_connection)
    else
      label=$(describe_screen "$screen")
    fi
    output+=$'\e[1m'"$(display_name "$screen")"$'\e[0m'": ${label}${clear_line}"$'\n'
    output+="${clear_line}"$'\n'

    if (( ${screen_option_count[$screen]} == 0 )); then
      output+="  No options available${clear_line}"$'\n'
    else
      for (( offset = 0; offset < ${screen_option_count[$screen]}; offset++ )); do
        label=${option_text[$(( ${first_option[$screen]} + offset ))]}
        if (( offset == cursor_option_offset )); then
          output+=$'\e[7m'"  > $label "$'\e[0m'"${clear_line}"$'\n'
        else
          output+="    $label${clear_line}"$'\n'
        fi
      done
    fi
  fi

  output+="${clear_line}"$'\n'"${status_message}${clear_line}"$'\n'$'\e[J'
  newlines=${output//[!$'\n']/}
  status_row=${#newlines}
  printf '%s' "$output"
}

restore_terminal() {
  printf '\e[?25h\e[?1049l'
}

main() {
  trap restore_terminal EXIT
  trap 'exit 130' INT TERM
  printf '\e[?1049h\e[?25l'

  local key sequence status last_refresh=$SECONDS last_probe=$SECONDS selected
  load_connections
  refresh
  render

  while true; do
    if read -rsn1 -t "$refresh_interval" key; then
      if [[ $key == $'\e' ]]; then
        sequence=""
        read -rsn2 -t 0.05 sequence
        key=$sequence
      fi
      case $key in
        q) break ;;
        '[A'|'OA') move_option -1 ;;
        '[B'|'OB') move_option 1 ;;
        '[C'|'OC') move_screen 1 ;;
        '[D'|'OD') move_screen -1 ;;
        '')
          if selected=$(selected_option_number); then
            apply_option "$selected"
            refresh
            (( apply_changed_layout )) && save_current_connection
            rebuild # the connection tab and its options depend on what was just saved
            last_refresh=$SECONDS
            last_probe=$SECONDS
          fi
          ;;
      esac
      render
    else
      status=$?
      (( status > 128 )) || break # input closed
    fi

    if (( SECONDS - last_probe >= probe_interval )); then
      last_probe=$SECONDS
      last_refresh=$SECONDS
      refresh && render
    elif (( SECONDS - last_refresh >= refresh_interval )); then
      last_refresh=$SECONDS
      refresh --current && render
    fi
  done
}

main
